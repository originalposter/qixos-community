#!/usr/bin/env python3
"""Run the qixos test suite.

The suite is a list of scenarios, each a fleet state and the tests that read it. A
scenario's `setup` is the outer config to apply before its tests run.

Where a new test goes depends on whether apply is part of what it is testing. If it is,
the test owns the apply and gets a scenario of its own with no setup, because running
apply invalidates the fleet every other test in a scenario is reading. If it is not, the
test joins a scenario with a setup and must not run `qixos-rebuild` itself.

Applying a scenario removes the previous one's AppVMs, which is what keeps scenarios
from depending on each other. Qubes without `deleteOnRemoval`, templates included,
survive it.

`./run` runs everything. `./run <scenario>` runs one, which is how to look at a failure:
nothing after it applies anything, so its nubes stay up. `./run <scenario> <test>` runs a
single test, still applying the scenario's setup first so it reads a fleet it can trust.

An in-nube test can be run faster still, without any apply, straight from the nube that
declares it: `ssh <nube>.qube run-tests <name>`.

Adding an admin test: write an executable under admin/ that exits non-zero on failure,
then add it to a scenario below.

Adding an in-nube test: declare it in the nube's own nix config through
`qixosTests.tests`, which puts it behind that nube's `run-tests`. If the nube is already
named by a scenario there is nothing to add here.
"""
import collections
import os
import pathlib
import re
import subprocess
import sys

from admin import harness

# This file lives at <repo>/users/op/tests/run.
REPO_ROOT = pathlib.Path(__file__).resolve().parents[3]

# Every qube the suite creates carries this, whatever the scenario. Teardown goes by it
# rather than by the management tag, which is also on the admin, its base template and
# the cluster templates.
SUITE_PREFIX = "test-"

# `setup` is the outer config to apply first, or None when the scenario's tests bring
# their own. See the module docstring for which a test wants.
Scenario = collections.namedtuple("Scenario", "name setup tests")

# Only the in-nube runner's own verdict lines. It captures and indents whatever a test
# prints, so a test cannot forge one of these.
VERDICT = re.compile(r"^(PASS|FAIL) (\S+)$")


def apply_config(flake):
    """Build and switch a scenario's nubes before its tests run.

    Without this the suite tests qubes that were created but never built. `apply
    --no-switch`, which is all the memory check runs, reconciles qubes-level state and
    leaves an AppVM booting its template's config, carrying none of what its own config
    declares: no test programs, and nothing to reach them over.

    --update, because without it the generated flake in the template keeps the copy of
    these local flakes it locked on a previous run, and the suite then tests code that
    is not in the tree. That is the worst thing a suite can do, and it is silent: an
    edited module runs green against the old build. It does not drag nixpkgs or qixCore
    along, since it updates the generated lockfile rather than each nube flake's own,
    and it costs nothing when the tree has not changed.

    Not captured: an apply runs for minutes and its progress should be visible as it
    happens rather than arriving at the end.
    """
    return subprocess.run(
        ["qixos-rebuild", "--flake", flake, "apply", "--update"]
    ).returncode == 0


def suite_qubes():
    """Running qubes the suite created, whatever their class.

    Templates included: one carrying deleteOnRemoval is evicted by the next apply the
    same way an AppVM is, and refuses removal while it runs. Halting a template that is
    kept costs a boot the apply was going to pay anyway, and commits its root volume,
    which is the state its cluster's AppVMs snapshot.
    """
    result = subprocess.run(
        ["qvm-ls", "--running", "--raw-data", "--fields", "NAME"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"could not list running qubes: {result.stderr.strip()}", file=sys.stderr)
        return []

    return [
        name for name in (line.strip() for line in result.stdout.splitlines())
        if name.startswith(SUITE_PREFIX)
    ]


def shut_down_suite():
    """Stop every qube the suite owns, and say whether they all stopped."""
    stopped = True
    for vm in suite_qubes():
        if not harness.shut_down(vm):
            stopped = False
    return stopped


def admin_test(*argv):
    """Run an executable from this tree, letting its output through as it goes."""
    return subprocess.run([str(REPO_ROOT / argv[0]), *argv[1:]]).returncode == 0


def nube_tests(vm):
    """Run a nube's own tests and reconcile them against what it said it had."""
    # Created is not enough: in-nube tests need the qube running, and apply reconciles
    # qubes-level state without starting anything.
    #
    # A fresh boot rather than --skip-if-running. An AppVM takes its config at boot, so
    # one that was already up when the template switched keeps the old one, and the
    # tests would pass against a build nobody asked for. A reboot per run is cheap next
    # to a green suite that tested the wrong closure.
    if not harness.boot(vm):
        return False

    # Ask what it has before running anything. A nube that dies partway through
    # otherwise reports a handful of passes and looks green.
    listing = harness.ssh(vm, "run-tests", "--list")
    if listing.returncode != 0:
        print(f"could not list tests on {vm}: {listing.stderr.strip()}", file=sys.stderr)
        return False

    declared = set(listing.stdout.split())
    if not declared:
        print(f"{vm} declares no tests", file=sys.stderr)
        return False

    result = harness.ssh(vm, "run-tests")

    # Indented, so a nube's own verdicts stay distinguishable from this runner's.
    for line in result.stdout.splitlines():
        print(f"  {line}")
    for line in result.stderr.splitlines():
        print(f"  {line}", file=sys.stderr)

    # run-tests exits 1 when a test fails and 0 when none do. Anything else is the run
    # coming apart, which the reconcile below would otherwise report as tests that
    # never ran, without saying why.
    if result.returncode not in (0, 1):
        print(f"run-tests on {vm} exited {result.returncode}", file=sys.stderr)

    reported = {}
    for line in result.stdout.splitlines():
        match = VERDICT.match(line)
        if match:
            reported[match.group(2)] = match.group(1)

    failed = sorted(name for name, verdict in reported.items() if verdict == "FAIL")
    missing = sorted(declared - set(reported))
    unexpected = sorted(set(reported) - declared)

    for name in failed:
        print(f"{vm}: failed {name}", file=sys.stderr)
    for name in missing:
        print(f"{vm}: never ran {name}", file=sys.stderr)
    for name in unexpected:
        print(f"{vm}: reported but not declared: {name}", file=sys.stderr)

    return not (failed or missing or unexpected)


SMOKE = "./users/op/tests/outer-configs/smoke#smoke"

SCENARIOS = [
    Scenario(
        name="smoke",
        setup=SMOKE,
        tests=[
            ("password-nube", lambda: nube_tests("test-smoke-password")),

            # Three checks over the same two nubes rather than one doing all of it, so
            # a failure names which property broke. Each boots the nubes it needs,
            # which takes a few minutes but keeps any of them runnable alone.
            #
            # ssh-keys-not-the-templates runs first because it is what unmasks the
            # one after it: a host key baked into the template survives a reboot too,
            # so ssh-keys-persist passes for the wrong reason until that one passes.
            # While both are red they are one bug, not two.
            ("ssh-keys-not-the-templates", lambda: admin_test(
                "./users/op/tests/admin/appvm_host_keys_are_not_the_templates.py",
                "test-smoke-template",
                "test-smoke-ssh-a",
                "test-smoke-ssh-b",
            )),
            ("ssh-keys-persist", lambda: admin_test(
                "./users/op/tests/admin/ssh_host_keys_survive_reboot.py",
                "test-smoke-ssh-a",
            )),
            ("ssh-keys-distinct-per-nube", lambda: admin_test(
                "./users/op/tests/admin/sibling_appvms_have_distinct_host_keys.py",
                "test-smoke-ssh-a",
                "test-smoke-ssh-b",
            )),

            # Any nube shows this: it is a property of how every one of them boots, not
            # of what this one runs.
            ("task-limit-not-from-boot-memory", lambda: admin_test(
                "./users/op/tests/admin/task_limit_is_not_sized_by_boot_memory.py",
                "test-smoke-ssh-a",
            )),
        ],
    ),

    # Its own scenario because it applies: it reconciles the smoke config itself and
    # then removes the nube it asserted on, which would take that nube out from under
    # anything sharing a fleet with it.
    Scenario(
        name="memory",
        setup=None,
        tests=[
            ("memory-matches-expected", lambda: admin_test(
                "./users/op/tests/admin/memory_matches_expected.py",
                SMOKE,
                "test-smoke-nube",
                "600",
            )),
        ],
    ),

    # Also applies, and its apply is the thing under test: it is meant to be killed
    # part way through.
    Scenario(
        name="oom",
        setup=None,
        tests=[
            ("oom-switch-reports-oom", lambda: admin_test(
                "./users/op/tests/admin/oomed_switch_reports_oom.py",
                "./users/op/tests/outer-configs/oom#oom",
                "test-oom-template",
            )),
        ],
    ),
]


def run_scenario(scenario):
    """Apply a scenario's fleet state if it has one, then run its tests."""
    # Halted first, whatever the scenario. Qubes refuses to remove a running qube, so an
    # apply that should evict the previous scenario's AppVMs dies part way through if
    # they are still up, and that apply is the only thing keeping scenarios independent.
    # A scenario needing its nubes running starts them itself.
    shut_down_suite()

    if scenario.setup is not None:
        # Fatal for this scenario only. Its tests all read state the apply produces, so
        # running them against a failed apply reports on whatever was there before.
        if not apply_config(scenario.setup):
            print(f"FAIL {scenario.name}/apply")
            return False
        print(f"PASS {scenario.name}/apply")

        # An AppVM snapshots its template's store as of the template's last shutdown.
        if not shut_down_suite():
            print(f"FAIL {scenario.name}/settle")
            return False

    passed = True
    for name, test in scenario.tests:
        if test():
            print(f"PASS {scenario.name}/{name}")
        else:
            print(f"FAIL {scenario.name}/{name}")
            passed = False
    return passed


def main(argv):
    # Outer config refs, and the localFlake paths inside them, resolve against the
    # repo root, so run from there whatever the caller's cwd.
    os.chdir(REPO_ROOT)

    if argv[1:2] in (["-h"], ["--help"]):
        print(f"usage: {argv[0]} [<scenario> [<test>]]", file=sys.stderr)
        for scenario in SCENARIOS:
            print(f"  {scenario.name}", file=sys.stderr)
            for name, _ in scenario.tests:
                print(f"    {name}", file=sys.stderr)
        return 0

    scenarios = SCENARIOS
    if len(argv) > 1:
        scenarios = [s for s in SCENARIOS if s.name == argv[1]]
        if not scenarios:
            print(f"no such scenario: {argv[1]}", file=sys.stderr)
            print("known:", ", ".join(s.name for s in SCENARIOS), file=sys.stderr)
            return 2

    if len(argv) > 2:
        # The setup still runs. A test that reads a fleet has to be told the fleet is
        # what its scenario says, and skipping the apply to save a few minutes is how a
        # green result against a stale nube happens.
        chosen = [t for t in scenarios[0].tests if t[0] == argv[2]]
        if not chosen:
            print(f"no test {argv[2]} in scenario {argv[1]}", file=sys.stderr)
            print("known:", ", ".join(n for n, _ in scenarios[0].tests), file=sys.stderr)
            return 2
        scenarios = [scenarios[0]._replace(tests=chosen)]

    # Every scenario runs, including after a failure. Stopping early would strand the
    # later ones behind tests that are red on purpose until the bug they describe is
    # fixed. To keep a failing scenario's nubes to look at, run that scenario alone.
    rc = 0
    for scenario in scenarios:
        if not run_scenario(scenario):
            rc = 1

    if rc == 0:
        shut_down_suite()

    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
