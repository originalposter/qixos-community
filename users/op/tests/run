#!/usr/bin/env python3
"""Run the qixos test suite.

Adding an admin test: write an executable under admin/ that exits non-zero on failure,
then add an entry to CHECKS below.

Adding an in-nube test: declare it in the nube's own nix config through
`qixosTests.tests`, which puts it behind that nube's `run-tests`. If the nube already
appears in CHECKS there is nothing to add here.
"""
import os
import pathlib
import re
import subprocess
import sys

from admin import harness

# This file lives at <repo>/users/op/tests/run.
REPO_ROOT = pathlib.Path(__file__).resolve().parents[3]

# The scenario this run applies. Runner-level rather than a check's own business: it
# names what is under test, where a check's expectations belong with the check.
SCENARIO = "./users/op/tests/outer-configs/smoke#smoke"

# Every qube the scenario creates carries this, and it has to match the `prefix` in the
# outer config. Teardown goes by it rather than by the management tag, which is also on
# the admin, its base template and the cluster template.
SCENARIO_PREFIX = "test-smoke-"

# Only the in-nube runner's own verdict lines. It captures and indents whatever a test
# prints, so a test cannot forge one of these.
VERDICT = re.compile(r"^(PASS|FAIL) (\S+)$")


def apply_scenario():
    """Build and switch the scenario's nubes before anything is tested.

    Without this the suite tests qubes that were created but never built. `apply
    --no-switch`, which is all the memory check runs, reconciles qubes-level state and
    leaves an AppVM booting its template's config, carrying none of what its own config
    declares: no test programs, and nothing to reach them over.

    --update, because without it the generated flake in the template keeps the copy of
    these local flakes it locked on a previous run, and the suite then tests code that
    is not in the tree. That is the worst thing a suite can do, and it is silent: an
    edited module runs green against the old build. It does not drag nixpkgs or qixCore
    along, since it updates the generated lockfile rather than each nube flake's own,
    and it costs nothing when the tree has not changed.

    Not captured: an apply runs for minutes and its progress should be visible as it
    happens rather than arriving at the end.
    """
    return subprocess.run(
        ["qixos-rebuild", "--flake", SCENARIO, "apply", "--update"]
    ).returncode == 0


def scenario_appvms():
    """Running AppVMs belonging to this scenario.

    Class as well as prefix, because sys-net is an AppVM too.
    """
    result = subprocess.run(
        ["qvm-ls", "--running", "--raw-data", "--fields", "NAME,CLASS"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"could not list running qubes: {result.stderr.strip()}", file=sys.stderr)
        return []

    names = []
    for line in result.stdout.splitlines():
        name, _, vm_class = line.partition("|")
        if vm_class == "AppVM" and name.startswith(SCENARIO_PREFIX):
            names.append(name)
    return names


def shut_down_scenario():
    """Stop the AppVMs the run left up.

    An AppVM discards its root volume when it stops, so on a failed run that is where
    the evidence would go. Only called once everything has passed.
    """
    for vm in scenario_appvms():
        # Warned about rather than failed on, like the memory check's cleanup: a
        # cleanup problem must not be mistaken for a test result, nor pass unnoticed.
        # harness.shut_down says what went wrong.
        harness.shut_down(vm)


def admin_test(*argv):
    """Run an executable from this tree, letting its output through as it goes."""
    return subprocess.run([str(REPO_ROOT / argv[0]), *argv[1:]]).returncode == 0


def nube_tests(vm):
    """Run a nube's own tests and reconcile them against what it said it had."""
    # Created is not enough: in-nube tests need the qube running, and apply reconciles
    # qubes-level state without starting anything.
    #
    # A fresh boot rather than --skip-if-running. An AppVM takes its config at boot, so
    # one that was already up when the template switched keeps the old one, and the
    # tests would pass against a build nobody asked for. A reboot per run is cheap next
    # to a green suite that tested the wrong closure.
    if not harness.boot(vm):
        return False

    # Ask what it has before running anything. A nube that dies partway through
    # otherwise reports a handful of passes and looks green.
    listing = harness.ssh(vm, "run-tests", "--list")
    if listing.returncode != 0:
        print(f"could not list tests on {vm}: {listing.stderr.strip()}", file=sys.stderr)
        return False

    declared = set(listing.stdout.split())
    if not declared:
        print(f"{vm} declares no tests", file=sys.stderr)
        return False

    result = harness.ssh(vm, "run-tests")

    # Indented, so a nube's own verdicts stay distinguishable from this runner's.
    for line in result.stdout.splitlines():
        print(f"  {line}")
    for line in result.stderr.splitlines():
        print(f"  {line}", file=sys.stderr)

    # run-tests exits 1 when a test fails and 0 when none do. Anything else is the run
    # coming apart, which the reconcile below would otherwise report as tests that
    # never ran, without saying why.
    if result.returncode not in (0, 1):
        print(f"run-tests on {vm} exited {result.returncode}", file=sys.stderr)

    reported = {}
    for line in result.stdout.splitlines():
        match = VERDICT.match(line)
        if match:
            reported[match.group(2)] = match.group(1)

    failed = sorted(name for name, verdict in reported.items() if verdict == "FAIL")
    missing = sorted(declared - set(reported))
    unexpected = sorted(set(reported) - declared)

    for name in failed:
        print(f"{vm}: failed {name}", file=sys.stderr)
    for name in missing:
        print(f"{vm}: never ran {name}", file=sys.stderr)
    for name in unexpected:
        print(f"{vm}: reported but not declared: {name}", file=sys.stderr)

    return not (failed or missing or unexpected)


CHECKS = [
    ("memory", lambda: admin_test(
        "./users/op/tests/admin/memory_matches_expected.py",
        SCENARIO,
        "test-smoke-nube",
        "600",
    )),
    ("password-nube", lambda: nube_tests("test-smoke-password")),

    ("ssh-keys-persist", lambda: admin_test(
        "./users/op/tests/admin/ssh_host_keys_survive_reboot.py",
        "test-smoke-ssh-a",
    )),
]


def main():
    # Outer config refs, and the localFlake paths inside them, resolve against the
    # repo root, so run from there whatever the caller's cwd.
    os.chdir(REPO_ROOT)

    # Before any check, and fatal: every check below reads state this produces, so
    # running them against a failed apply reports on the previous run's qubes.
    if not apply_scenario():
        print("FAIL apply")
        return 1
    print("PASS apply")

    rc = 0
    for name, check in CHECKS:
        if check():
            print(f"PASS {name}")
        else:
            print(f"FAIL {name}")
            rc = 1

    if rc == 0:
        shut_down_scenario()

    return rc


if __name__ == "__main__":
    sys.exit(main())
